{
  "include": ["."],
  "exclude": [".venv", "__pycache__", ".ruff_cache", "build", "dist"],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.10",
  "pythonPlatform": "All",
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "warning",
  "reportUnusedImport": "error",
  "reportUnusedVariable": "error"
}